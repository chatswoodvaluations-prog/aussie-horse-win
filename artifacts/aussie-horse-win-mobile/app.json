{
  "expo": {
    "name": "AHW Mobile",
    "slug": "aussie-horse-win-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aussie-horse-win-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060D1F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aussiehorsewin.mobile",
      "associatedDomains": ["applinks:aussie-horse-win.replit.app"]
    },
    "android": {
      "package": "com.aussiehorsewin.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aussie-horse-win.replit.app",
              "pathPrefix": "/race"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://aussie-horse-win.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
